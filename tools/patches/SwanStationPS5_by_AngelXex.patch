+void GPU::SB()
+{
+  if (g_settings.display_crop_mode != DisplayCropMode::Borders || !m_borders_valid)
+    return;
+
+  constexpr uint32_t SHRINK_AFTER_FRAMES = 24;
+  uint16_t widened[4] = {std::min(m_borders_applied[0], m_borders_raw[0]), std::max(m_borders_applied[1], m_borders_raw[1]),
+                         std::min(m_borders_applied[2], m_borders_raw[2]), std::max(m_borders_applied[3], m_borders_raw[3])};
+  bool changed = false;
+  if (std::memcmp(widened, m_borders_applied, sizeof(widened)) != 0)
+  {
+    std::memcpy(m_borders_applied, widened, sizeof(widened));
+    m_borders_stable_frames = 0;
+    changed = true;
+  }
+  else if (std::memcmp(m_borders_raw, m_borders_applied, sizeof(m_borders_raw)) != 0)
+  {
+    if (std::memcmp(m_borders_raw, m_borders_candidate, sizeof(m_borders_raw)) != 0)
+    {
+      std::memcpy(m_borders_candidate, m_borders_raw, sizeof(m_borders_candidate));
+      m_borders_stable_frames = 1;
+    }
+    else if (++m_borders_stable_frames >= SHRINK_AFTER_FRAMES)
+    {
+      std::memcpy(m_borders_applied, m_borders_raw, sizeof(m_borders_applied));
+      m_borders_stable_frames = 0;
+      changed = true;
+    }
+  }
+  else
+  {
+    m_borders_stable_frames = 0;
+  }
+
+  if (changed)
+    UpdateCRTCDisplayParameters();
+}
